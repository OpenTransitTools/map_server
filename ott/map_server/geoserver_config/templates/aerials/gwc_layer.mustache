<GeoServerTileLayer>
  <id>LayerGroup-{{workspace}}</id>
  <name>{{workspace}}:{{workspace}}</name>
  <enabled>true</enabled>
  <mimeFormats>
    <string>image/png</string>
    <string>image/jpeg</string>
  </mimeFormats>
  <gridSubsets>
    <gridSubset>
      <gridSetName>EPSG:4326</gridSetName>
    </gridSubset>
    <gridSubset>
      <gridSetName>EPSG:900913</gridSetName>
    </gridSubset>
    <gridSubset>
      <gridSetName>EPSG:2913</gridSetName>
    </gridSubset>
  </gridSubsets>
  <metaWidthHeight>
    <int>4</int>
    <int>4</int>
  </metaWidthHeight>
  <gutter>0</gutter>
  <parameterFilters/>
  <expireCache>0</expireCache>
  <expireClients>0</expireClients>
  <cacheWarningSkips/>
</GeoServerTileLayer>
